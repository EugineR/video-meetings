generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id         String      @id @default(uuid())
  email      String      @unique
  password   String
  name       String?
  createdAt  DateTime    @default(now())
  updatedAt  DateTime    @updatedAt
  meetings   Meeting[]
  avatar     UserAvatar?
  ownedTasks Task[]

  @@map("users")
}

model Meeting {
  id           String             @id @default(uuid())
  title        String
  date         DateTime
  participants String[]
  ownerId      String
  owner        User               @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  createdAt    DateTime           @default(now())
  updatedAt    DateTime           @updatedAt
  recordings   MeetingRecording[]
  summary      MeetingSummary?
  tasks        Task[]

  @@map("meetings")
}

enum RecordingStatus {
  UPLOADED
  PROCESSING
  READY
  FAILED
}

model MeetingRecording {
  id               String          @id @default(uuid())
  meetingId        String
  meeting          Meeting         @relation(fields: [meetingId], references: [id], onDelete: Cascade)
  originalFilename String
  storagePath      String
  mimeType         String
  sizeBytes        BigInt
  status           RecordingStatus @default(UPLOADED)
  transcriptText   String?
  createdAt        DateTime        @default(now())
  updatedAt        DateTime        @updatedAt

  @@map("meeting_recordings")
}

enum SummaryStatus {
  PENDING
  PROCESSING
  READY
  FAILED
}

/**
 * One row per meeting (`meetingId` is `@unique`), covering every one of its recordings.
 * `actionItems`/`decisions` are structured JSON rather than separate tables — see
 * `meeting-summary/interfaces/meeting-summary-response.interface.ts` for the shape written into
 * them, always produced by `MeetingSummaryService` itself, never from untrusted input.
 */
model MeetingSummary {
  id                 String        @id @default(uuid())
  meetingId          String        @unique
  meeting            Meeting       @relation(fields: [meetingId], references: [id], onDelete: Cascade)
  status             SummaryStatus @default(PENDING)
  summaryText        String?
  actionItems        Json          @default("[]")
  decisions          Json          @default("[]")
  /// Ids of the `MeetingRecording`s (in `createdAt` order) already folded into `summaryText`/
  /// `actionItems`/`decisions` — lets `MeetingSummaryService.generateForMeeting` resume folding
  /// from the first recording not yet reflected here instead of always refolding every ready
  /// recording from scratch. See that method's doc comment for the full resume-vs-refold rule.
  foldedRecordingIds String[]      @default([])
  createdAt          DateTime      @default(now())
  updatedAt          DateTime      @updatedAt

  @@map("meeting_summaries")
}

enum TaskStatus {
  OPEN
  IN_PROGRESS
  DONE
}

/**
 * A standalone action item, tracked independently of the `MeetingSummary` run that first surfaced
 * it. `TaskService.upsert` is the only writer: it de-duplicates by title similarity (Postgres
 * `pg_trgm`, see the `add_task` migration) instead of always inserting, so the same recurring
 * action item doesn't pile up as separate rows across meetings.
 * `ownerId` is nullable: it's only ever set by `TaskTools` (`/mcp`'s `upsert_task`, from the
 * caller's `McpRequester` — never from a tool argument), not by `meeting-tools.ts`'s in-process
 * `upsert_task` (the background summarization agent has no authenticated caller to attribute a task
 * to). A `null` owner is therefore invisible to every owner-scoped `/mcp` read (`find_tasks`,
 * `tasks://open`, `task://{id}`) — see `apps/api/CLAUDE.md`'s Invariants.
 */
model Task {
  id              String     @id @default(uuid())
  title           String
  sourceMeetingId String
  sourceMeeting   Meeting    @relation(fields: [sourceMeetingId], references: [id], onDelete: Cascade)
  ownerId         String?
  owner           User?      @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  status          TaskStatus @default(OPEN)
  createdAt       DateTime   @default(now())

  @@index([title(ops: raw("gin_trgm_ops"))], type: Gin, map: "tasks_title_trgm_idx")
  @@map("tasks")
}

model UserAvatar {
  id               String   @id @default(uuid())
  userId           String   @unique
  user             User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  originalFilename String
  storagePath      String
  mimeType         String
  sizeBytes        BigInt
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  @@map("user_avatars")
}
